# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# Every provider below is optional: CodeLoop shows each one in its model picker, and the ones without a
# key are marked "Not set up". Ollama needs no key at all.

# ---------------------------------------------------------------------------
# Your projects
# ---------------------------------------------------------------------------
# The folder whose sub-folders are your projects (repositories). Use an absolute path.
# Running CodeLoop yourself (uvicorn):
CODELOOP_WORKSPACE_ROOT=./workspace
# Running it in Docker: the host folder that is mounted into the container as the workspace.
# CODELOOP_HOST_WORKSPACE=C:/Users/you/code

# Which provider new chats use until you pick another in the web app.
CODELOOP_DEFAULT_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Local models: Ollama (free, private, works offline)
# Install from https://ollama.com, then:  ollama pull qwen3:4b-instruct
# The agent needs a context of about 16k tokens. Ollama chooses it from your GPU memory; if `ollama ps` shows
# less, set OLLAMA_CONTEXT_LENGTH=16384 in Ollama's own environment and restart Ollama.
# ---------------------------------------------------------------------------
CODELOOP_OLLAMA_BASE_URL=http://localhost:11434/v1
CODELOOP_OLLAMA_MODEL=qwen3:4b-instruct

# ---------------------------------------------------------------------------
# Hosted models: add the keys you have. The default model for each can be changed too.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# CODELOOP_ANTHROPIC_MODEL=claude-opus-5-5
# CODELOOP_ANTHROPIC_EFFORT=high
# OPENAI_API_KEY=
# CODELOOP_OPENAI_MODEL=gpt-5-mini
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# Any other OpenAI-compatible server (LM Studio, vLLM, llama.cpp, Together, ...)
# CODELOOP_CUSTOM_BASE_URL=http://localhost:1234/v1
# CODELOOP_CUSTOM_MODEL=qwen2.5-coder-7b-instruct
# CODELOOP_CUSTOM_API_KEY=

# ---------------------------------------------------------------------------
# What the agent may do
# ---------------------------------------------------------------------------
# Programs the agent may run when a chat allows commands (first word of the command).
# CODELOOP_COMMAND_ALLOWLIST=pytest,python,npm,npx,node,go,cargo,ruff,eslint,tsc,vitest,jest,git
# CODELOOP_COMMAND_TIMEOUT_SECONDS=180
# Set to false to switch command running off for every chat.
# CODELOOP_ALLOW_COMMANDS=true
# CODELOOP_MAX_STEPS=12

# ---------------------------------------------------------------------------
# Hindsight (long-term memory)
# ---------------------------------------------------------------------------
# Where the Hindsight server is. docker-compose sets this for the app container itself.
CODELOOP_HINDSIGHT_URL=http://localhost:8888
# CODELOOP_HINDSIGHT_API_KEY=

# The model Hindsight uses to turn chats into facts. Option A: Ollama (free, local).
# Ollama answers one request at a time, so while Hindsight files a chat or a project scan, the agent's next
# question waits behind it. On a machine with 8 GB of RAM a scan can keep a 4B model busy for 20+ minutes.
# If that's you: give Hindsight a smaller model (e.g. qwen3:1.7b), or use Option B so note-taking happens
# off your machine and the local model is free for the agent.
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_API_KEY=ollama
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_API_LLM_MODEL=qwen3:4b-instruct
# Small models need these so note extraction stays within their limits:
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_OLLAMA_NUM_CTX=8192
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=4000
HINDSIGHT_API_RETAIN_CHUNK_SIZE=2000
# A laptop model can need minutes to file a chat; Hindsight's defaults would time out and retry.
HINDSIGHT_API_RETAIN_LLM_TIMEOUT=900
HINDSIGHT_API_CONSOLIDATION_LLM_TIMEOUT=900
HINDSIGHT_API_REFLECT_LLM_TIMEOUT=300

# Option B: OpenAI (faster note-taking; replace the Option A lines above)
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_API_KEY=sk-...
# HINDSIGHT_API_LLM_MODEL=gpt-5-mini
